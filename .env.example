ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=   # brain (DeepSeek) + body's eyes (Gemini). Budget: <$15/day total
ELEVENLABS_API_KEY=   # body voice
ELEVEN_VOICE_ID=      # optional; default Callum. List yours: python3 -m body.voice_lab --voices
ELEVEN_MODEL=         # optional; default eleven_v3 (acts out [menacing] etc.)

# Brain (PRD B)
BRAIN_LLM=openrouter      # openrouter (default: DeepSeek via OpenRouter) | deepseek | claude
OPENROUTER_FAST_MODEL=    # default deepseek/deepseek-v4.1-flash
OPENROUTER_STRONG_MODEL=  # default deepseek/deepseek-v4.1-flash (kill turns must answer in <3s)
DEEPSEEK_API_KEY=         # only needed when BRAIN_LLM=deepseek
BRAIN_FAST_MODEL=haiku    # claude backend only
BRAIN_STRONG_MODEL=sonnet # claude backend only
JUMP_TARGET_URL=          # http://<a-box-you-own>:5000 — where the `jump` tool lands
BRAIN_PORT=5000           # body POSTs state to http://<linux>:5000/think
PLEA_ROOM_PORT=5001       # audience web chat  (/ chat, /screen projector, /qr)
PLEA_ROOM_URL=            # override the QR/join URL (else auto-detected LAN IP)

# Optional audience channels (web room is always on; these start only if set)
DISCORD_BOT_TOKEN=        # enable the Message Content intent in the dev portal
DISCORD_CHANNEL_ID=       # the one approved channel it reads/writes
WHATSAPP_ENABLE=0         # off by default (unofficial client, against WhatsApp ToS); 1 = scan QR to link
WHATSAPP_SESSION=         # optional session db path (default brain/whatsapp_session.sqlite3)

# Clip farm (brain/clipfarm.py) — needs system ffmpeg; assets in assets/
BROLL_INTERVAL=0.8        # seconds per B-roll cut during the drop (Superman-edit pace)
MUSIC_START=0             # seconds into assets/love_me.mp3 to start the drop clip
MUSIC_CHUNK=              # length of the song slice to use (blank = winner hold)
TTS_ENABLE=auto           # auto (on if edge-tts installed) | 1 | 0 — spoken persona lines
CLIP_STYLE=chat           # chat (group-chat UI) | cards (caption cards)
CHORUS_MAX_AIS=3          # how many AIs react to ARIA in the clip
CHORUS_MAX_CHARS=120      # cap on each line's length (captions + TTS)

X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
