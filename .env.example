ANTHROPIC_API_KEY=

# Brain (PRD B)
BRAIN_LLM=claude          # claude (default, uses `claude -p`, no key) | deepseek
DEEPSEEK_API_KEY=         # only needed when BRAIN_LLM=deepseek
BRAIN_FAST_MODEL=haiku    # snappy reactions
BRAIN_STRONG_MODEL=sonnet # big moments: death monologue, first words reborn, escape
JUMP_TARGET_URL=          # http://<a-box-you-own>:5000 — where the `jump` tool lands
BRAIN_PORT=5000           # body POSTs state to http://<linux>:5000/think
PLEA_ROOM_PORT=5001       # audience web chat  (/ chat, /screen projector, /qr)
PLEA_ROOM_URL=            # override the QR/join URL (else auto-detected LAN IP)

# Optional audience channels (web room is always on; these start only if set)
DISCORD_BOT_TOKEN=        # enable the Message Content intent in the dev portal
DISCORD_CHANNEL_ID=       # the one approved channel it reads/writes
WHATSAPP_ENABLE=1         # on by default; set 0 to disable (scan QR in terminal to link)
WHATSAPP_SESSION=         # optional session db path (default brain/whatsapp_session.sqlite3)

# Clip farm (brain/clipfarm.py) — needs system ffmpeg; assets in assets/
BROLL_INTERVAL=0.8        # seconds per B-roll cut during the drop (Superman-edit pace)
MUSIC_START=0             # seconds into assets/love_me.mp3 to start the drop clip
MUSIC_CHUNK=              # length of the song slice to use (blank = winner hold)

X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
